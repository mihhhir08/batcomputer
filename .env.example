# Copy this file to .env.local and fill in only what you want.
# Everything is optional. With nothing set, the terminal runs local-only and
# keeps your record in this browser.
#
# Never commit .env.local. Use YOUR OWN accounts and keys for every service.

# ── Lock ─────────────────────────────────────────────────────────────────────
# Four-digit PIN asked for on boot. Leave unset and the terminal opens freely.
# REQUIRED in production before cloud sync will switch on.
MISSION_PIN=

# ── Cloud sync (your own Supabase project) ───────────────────────────────────
# Run supabase/schema.sql in the SQL editor first. Both values are server-only:
# the browser never sees them.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Alfred's daily remark (your own OpenRouter key) ──────────────────────────
# Without a key he simply stays silent.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ── Nightly nudge email (your own Resend key) ────────────────────────────────
# Needs cloud sync. Resend's test sender only delivers to your own address,
# which is exactly the use case here, so no domain is required.
RESEND_API_KEY=re_...
NUDGE_EMAIL=you@example.com
NUDGE_FROM=BATCOMPUTER <onboarding@resend.dev>

# Any long random string (try: openssl rand -hex 32). The cron route refuses
# every caller without it.
CRON_SECRET=
